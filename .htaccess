Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nunca exponha código, configuração, banco, documentação ou uploads privados.
    RewriteRule ^(?:app|bin|config|database|docs|storage|tests|views)(?:/|$) - [F,L,NC]

    # A hospedagem Hostinger serve a raiz do repositório; os arquivos públicos
    # permanecem organizados em public/ e são mapeados sem redirecionamento.
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]
    RewriteRule ^robots\.txt$ public/robots.txt [L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "(^\.|\.ini$|\.log$|\.sql$|\.env$|\.md$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
